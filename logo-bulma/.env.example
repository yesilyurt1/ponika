# Kopyala: cp .env.example .env  →  değerleri doldur. .env dosyasını asla git'e ekleme.

# Alan adın (Caddy bunun için otomatik HTTPS sertifikası alır). DNS A kaydı sunucunun IP'sini göstermeli.
DOMAIN=1milyonuncumarka.com

# Yönetim paneli anahtarı: en az 16 karakter. Üret: openssl rand -hex 24
ADMIN_KEY=

# SMS sağlayıcısı (giriş kodu + hatırlatmalar).
#  netgsm  → Netgsm hesabı ve onaylı SMS başlığı gerekir
#  webhook → başka sağlayıcı için {to, message} alan ara servis (SMS_WEBHOOK_URL)
SMS_MODE=netgsm
NETGSM_USER=
NETGSM_PASS=
NETGSM_HEADER=
# SMS_WEBHOOK_URL=

# Ücretli telafi (5 TL): ödeme kuruluşu (iyzico, PayTR...) bağlanana kadar "off" kalmalı; seçenek sitede gizlenir.
PAYMENT_MODE=off

# Caddy/Nginx arkasında gerçek ziyaretçi IP'si için 1 (docker-compose ile böyle çalışır)
TRUST_PROXY=1

# Komisyon oranı (varsayılan data.js: 0.03)
# COMMISSION=0.03
