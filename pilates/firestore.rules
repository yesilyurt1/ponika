rules_version = '2';
// Pilates ders takvimi — Firestore güvenlik kuralları.
// ÖNEMLİ: Aşağıdaki listeye hocanın e-posta adresini yazın (config.js içindeki adminEmails ile aynı).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email.lower() in [
        'hoca@ornek.com'
      ];
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Üyenin bir derse yalnızca KENDİSİNİ eklemesine / çıkarmasına izin verir.
    function memberSlotChange() {
      let uid = request.auth.uid;
      let before = resource.data.attendees.toSet();
      let after = request.resource.data.attendees.toSet();
      let lateBefore = resource.data.get('lateCancels', []).toSet();
      let lateAfter = request.resource.data.get('lateCancels', []).toSet();
      let joins = after.difference(before) == [uid].toSet()
        && before.difference(after).size() == 0
        && lateAfter == lateBefore
        && request.resource.data.attendees.size() == resource.data.attendees.size() + 1
        && request.resource.data.attendees.size() <= resource.data.capacity;
      let leaves = before.difference(after) == [uid].toSet()
        && after.difference(before).size() == 0
        && (lateAfter == lateBefore || lateAfter.difference(lateBefore) == [uid].toSet());
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'lateCancels'])
        && resource.data.status == 'open'
        && (joins || leaves);
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create: if isSelf(uid) && request.resource.data.role == 'member';
      allow update: if isAdmin()
        || (isSelf(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if isAdmin();
    }

    match /packages/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /slots/{id} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && memberSlotChange());
    }

    // Bildirim kayıtları ve gönderici durumu: sadece GitHub Actions'taki gönderici yazar, hoca okur.
    match /notifications/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /system/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /bookings/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn()
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'booked'
            && get(/databases/$(database)/documents/packages/$(request.resource.data.packageId)).data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
            && resource.data.userId == request.auth.uid
            && resource.data.status == 'booked'
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.packageId == resource.data.packageId
            && request.resource.data.slotId == resource.data.slotId
            && request.resource.data.status in ['cancelled', 'late_cancel', 'moved']);
      allow delete: if isAdmin();
    }
  }
}
